# Server Environment Variables (Cloudflare Workers)
#
# Note: For Cloudflare Workers, environment variables are configured in wrangler.toml
# This file is kept for reference and local development documentation.
#
# See wrangler.toml for production configuration:
# - ENVIRONMENT: production/development
# - MAX_PARTICIPANTS: 50
# - MAX_EXPENSES: 500
# - MAX_TOTAL_SPLITS: 10000
# - SPLIT_EXPIRY_HOURS: 24
#
# D1 database is configured via wrangler.toml [[d1_databases]] binding
