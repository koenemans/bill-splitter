# Server Environment Variables
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Security Configuration
MAX_TOTAL_SPLITS=10000
RATE_LIMIT_WINDOW_MS=900000
# Tiered rate limiting - separate limits for read vs write operations
RATE_LIMIT_READ_MAX_PER_IP=200
RATE_LIMIT_WRITE_MAX_PER_IP=50
GLOBAL_RATE_LIMIT_MAX=2000
SPLIT_EXPIRY_MS=86400000
MEMORY_ALERT_THRESHOLD_MB=1000

# Logging Configuration
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
