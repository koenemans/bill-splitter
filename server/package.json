{
  "name": "bill-splitter-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create bill-splitter-db",
    "db:migrate": "wrangler d1 execute bill-splitter-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute bill-splitter-db --local --file=./schema.sql",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "hono": "^4.12.4",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@cloudflare/workers-types": "^4.20240117.0",
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.2.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "miniflare": "^3.20240129.0",
    "prettier": "^3.6.2",
    "wrangler": "^4.54.0"
  }
}
