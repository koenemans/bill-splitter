{
  "scripts": {
    "prebuild": "npm run install:all",
    "build": "npm run client:build",
    "start": "cd server && npm start"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "deployment": {
    "docker": {
      "image": "bill-splitter",
      "port": 3001,
      "healthcheck": "/api/health",
      "buildCommand": "docker build -t bill-splitter .",
      "runCommand": "docker-compose up -d"
    },
    "processManager": "pm2",
    "features": ["auto-restart", "process-monitoring", "log-management", "clustering"]
  }
}
