# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:5173

# Security Configuration (optional)
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PER_IP=20
GLOBAL_RATE_LIMIT_MAX=500

# Memory and storage limits
MAX_TOTAL_SPLITS=10000
SPLIT_EXPIRY_MS=86400000
MEMORY_ALERT_THRESHOLD_MB=1000

# Add any additional environment variables for production deployment
